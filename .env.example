# SMTP settings — works with Gmail, Outlook, Mailgun, Postmark, AWS SES,
# Resend (SMTP mode), or any other SMTP provider.
NUXT_MAIL_HOST=smtp.example.com
NUXT_MAIL_PORT=587
NUXT_MAIL_SECURE=false
NUXT_MAIL_USER=enquiries@example.com
NUXT_MAIL_PASS=your-smtp-password

# Address emails are sent FROM, and where website enquiries are delivered.
NUXT_MAIL_FROM="HVAC Services <enquiries@example.com>"
NUXT_MAIL_TO=inbox@example.com

# --- Provider examples ---
#
# Gmail (needs an App Password, not your normal password):
#   NUXT_MAIL_HOST=smtp.gmail.com
#   NUXT_MAIL_PORT=465
#   NUXT_MAIL_SECURE=true
#   NUXT_MAIL_USER=you@gmail.com
#   NUXT_MAIL_PASS=xxxx-xxxx-xxxx
#
# Mailgun:
#   NUXT_MAIL_HOST=smtp.mailgun.org
#   NUXT_MAIL_PORT=587
#   NUXT_MAIL_USER=postmg-xxxx
#   NUXT_MAIL_PASS=xxxxxxxx
#
# AWS SES:
#   NUXT_MAIL_HOST=email-smtp.us-east-1.amazonaws.com
#   NUXT_MAIL_PORT=587
#   NUXT_MAIL_USER=SES_SMTP_USER
#   NUXT_MAIL_PASS=SES_SMTP_PASS
#
# Local development (no real emails sent):
#   Run: pnpm dlx mailhog   (MailHog UI at http://localhost:8025)
#   NUXT_MAIL_HOST=localhost
#   NUXT_MAIL_PORT=1025
#   NUXT_MAIL_SECURE=false
#   (leave NUXT_MAIL_USER / NUXT_MAIL_PASS empty)
